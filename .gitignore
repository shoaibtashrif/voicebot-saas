# ════════════════════════════════════════════════════
# VOICEBOT SAAS PLATFORM — .gitignore
# ════════════════════════════════════════════════════

# ─── Secrets — NEVER commit these ───────────────────
.env
.env.local
.env.production
.env.staging
.env.development
*.env

# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
MANIFEST
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ─── Node.js ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
.parcel-cache
.next/
.nuxt/
dist/

# ─── Logs ────────────────────────────────────────────
*.log
logs/
server.log
service.log

# ─── Databases & Vector Store ────────────────────────
*.db
*.sqlite
*.sqlite3
chroma_data/
web_agents.db

# ─── Runtime / PIDs ──────────────────────────────────
pids/
*.pid
*.pid.lock
*.seed

# ─── Docker ──────────────────────────────────────────
.docker/

# ─── Cache ───────────────────────────────────────────
.cache/
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo

# ─── IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.iml

# ─── OS ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── SSL Certificates (use Let's Encrypt on server) ──
*.pem
*.key
*.crt
*.cert
